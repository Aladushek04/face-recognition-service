# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local storage paths
# Keep heavy runtime data outside the repository when needed.
BASE_DIR=D:\FaceService
ACTORS_DIR=D:\FaceService\actors
FAISS_INDEX_DIR=D:\FaceService\data\faiss_index
VIDEOS_DIR=D:\Videos

# Face Recognition
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.65
FACE_REFERENCE_VOTE_TOP_N=3
FACE_REFERENCE_VOTE_WEIGHT=0.2
FACE_REFERENCE_VOTE_BONUS=0.01
FAISS_CANDIDATE_MULTIPLIER=20
MAX_FACES_PER_IMAGE=10
EMBEDDING_DIM=512
FACE_EXECUTION_PROVIDERS=["CPUExecutionProvider"]
VIDEO_FRAME_STEP=1.0
VIDEO_FACE_RECOGNITION_THRESHOLD=0.55
VIDEO_FACE_STRONG_MATCH_THRESHOLD=0.68
VIDEO_FACE_SEARCH_K=5
VIDEO_MIN_ACTOR_HITS=2
VIDEO_FALLBACK_ENABLED=true
VIDEO_FALLBACK_FRAME_STEP=0.5
VIDEO_FALLBACK_FACE_RECOGNITION_THRESHOLD=0.48
VIDEO_FALLBACK_MIN_ACTOR_HITS=3
VIDEO_FALLBACK_TRIGGER_MIN_ACTORS=1
CONCURRENT_VIDEO_LIMIT=1
# For NVIDIA GPU after installing onnxruntime-gpu:
# FACE_EXECUTION_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]

# FAISS Index
FAISS_INDEX_TYPE=HNSW32
FAISS_M=32
FAISS_EF_CONSTRUCTION=256

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=["jpg","jpeg","png","webp","bmp"]

# StashDB ingestion
# Get a token from your StashDB profile and keep it out of scripts.
STASHDB_API_URL=https://stashdb.org/graphql
STASHDB_API_KEY=
